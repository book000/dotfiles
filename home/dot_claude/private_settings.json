{
  "env": {
    "CLAUDE_AFK_TIMEOUT_MS": "2147483647",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SIMPLE_SYSTEM_PROMPT": "1",
    "CLAUDE_CODE_USER_DIALOG_TIMEOUT_MS": "0",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
    "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "false",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "60",
    "CLAUDE_CODE_THRIFTY_SONIC": "0",
    "DISABLE_EXTRA_USAGE_COMMAND": "1",
    "ENABLE_TOOL_SEARCH": "auto",
    "IS_DEMO": "1"
  },
  "model": "opusplan",
  "autoMode": {
    "environment": ["$defaults"]
  },
  "permissions": {
    "deny": [
      "Bash(git config user.name:*)",
      "Bash(git config user.email:*)",
      "Bash(git config --global user.name:*)",
      "Bash(git config --global user.email:*)",
      "EnterPlanMode"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/completion-notify/notify-completion.sh",
            "onFailure": "continue"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/deep-review-require-fixes.sh",
            "onFailure": "continue"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/require-review-thread-fixes.sh",
            "onFailure": "continue"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/detect-leaked-toolcall.sh",
            "onFailure": "continue"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/detect-leaked-toolcall.sh",
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/completion-notify/notify-askuserquestion.sh",
            "onFailure": "continue"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/rtk-rewrite.sh",
            "onFailure": "continue"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/git-config-guard.sh",
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/deep-review-immediate-fix.sh",
            "onFailure": "continue"
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/completion-notify/notify-post-tool-use.sh",
            "onFailure": "continue"
          }
        ]
      },
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/trust-worktree-cwd.sh",
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/completion-notify/notify-permission-request.sh",
            "onFailure": "continue"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/completion-notify/notify-notification.sh",
            "onFailure": "continue"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/completion-notify/notify-user-prompt-submit.sh",
            "onFailure": "continue"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "enableWorkflows": false,
  "statusLine": {
    "type": "command",
    "command": "ccstatusline"
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail",
        "ref": "v5.3.2"
      }
    }
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "ponytail@ponytail": true
  },
  "language": "Use Japanese for interaction with humans and creating plans. Write the Markdown below .claude in English.",
  "feedbackSurveyRate": 0,
  "effortLevel": "medium",
  "awaySummaryEnabled": false,
  "showClearContextOnPlanAccept": true,
  "autoMemoryEnabled": false,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "verbose": false,
  "preferredNotifChannel": "auto",
  "teammateMode": "in-process",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "remoteControlAtStartup": true,
  "autoContinueAtUsageLimit": true
}
